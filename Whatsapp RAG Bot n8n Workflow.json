    {
      "parameters": {
        "jsCode": "// Implementation logic remains completely intact\n// Get the user's original prompt from the Text Only Prompt node\nconst userPrompt = $node['Text Only Prompt'].json.text;\n\n// Get query embedding from OpenAI node\nconst queryEmbedding =$node[\"HTTP Request1\"].json.data[0].embedding;\n\n// Get all SOP records from Airtable - try different access patterns\nlet sopRecords = [];\ntry {\n  sopRecords = $node[\"Search records\"].json.items || \n               $input.all().map(item => item.json) ||\n               [];\n} catch (error) {\n  console.log(\"Error accessing SOP records:\", error.message);\n}\n\nfunction cosineSimilarity(vectorA, vectorB) {\n  let dotProduct = 0, magnitudeA = 0, magnitudeB = 0;\n  for (let i = 0; i < vectorA.length; i++) {\n    dotProduct += vectorA[i] * vectorB[i];\n    magnitudeA += vectorA[i] * vectorA[i];\n    magnitudeB += vectorB[i] * vectorB[i];\n  }\n  return dotProduct / (Math.sqrt(magnitudeA) * Math.sqrt(magnitudeB));\n}\n\nconst similarities = [];\nif (sopRecords && Array.isArray(sopRecords)) {\n  sopRecords.forEach((record, index) => {\n    const fields = record.fields || record;\n    const sopEmbeddingText = fields.Embedding;\n    let sopEmbedding = typeof sopEmbeddingText === 'string' ? JSON.parse(sopEmbeddingText) : sopEmbeddingText;\n    if (Array.isArray(sopEmbedding) && sopEmbedding.length > 0) {\n      similarities.push({\n        text: fields.Text || '',\n        source: fields.Source || 'Unknown',\n        similarity: cosineSimilarity(queryEmbedding, sopEmbedding)\n      });\n    }\n  });\n}\n\nconst topSOPs = similarities.sort((a, b) => b.similarity - a.similarity).slice(0, 3).filter(sop => sop.similarity > 0.3);\n\nlet enhancedPrompt;\nif (topSOPs.length > 0) {\n  let sopContext = topSOPs.map((sop, i) => `SOP ${i + 1} (Source: ${sop.source}):\\n${sop.text}\\n\\n---\\n\\n`).join('');\n  enhancedPrompt = `RELEVANT COMPANY SOPs:\\n\\n${sopContext}USER QUERY: ${userPrompt}\\n\\nInstructions: Use the relevant SOPs above to provide accurate company-specific information.`;\n} else {\n  enhancedPrompt = `USER QUERY: ${userPrompt}\\n\\nInstructions: No relevant company SOPs found. Respond based on your general knowledge.`;\n}\n\nreturn [{\n  json: {\n    enhancedPrompt,\n    relevantSOPs: topSOPs,\n    sopCount: topSOPs.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
